<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!-- Failure alerts. Any error that stops the run is emailed here:
         a rejected portal credential, an MFA timeout, a ChromeDriver that
         will not start, an unreachable database, or any fatal crash.
         Screenshots are attached when the browser was still running.
         Separate several addresses with ';'. If this key is missing or
         blank, the two defaults below are used anyway. -->
    <add key="failure_email_to" value="techsupport2@cfsgroup.com;nandan.hegde@cfsgroup.com" />
    <add key="failure_email_cc" value="" />

    <!-- Set to false to silence alerts without removing the addresses. -->
    <add key="email_enabled" value="true" />

    <!-- In-house Email API (same service the other schedulers use).
         Deliberately not SmtpClient: Office 365 no longer accepts basic
         authentication, so direct SMTP with a username and password fails. -->
    <add key="email_api_base_url" value="http://172.16.10.2:8081/" />
    <add key="email_endpoint_attachment" value="/SendEmailSMS/SendEmailwithBytes" />
    <add key="email_client_id" value="CONT-EMAILSMS-API" />
    <add key="email_client_secret" value="fbJSCL2vv6HxZAkQxozI" />
    <add key="email_from" value="DoNotReply@cfsgroup.com" />
    <add key="email_host" value="smtp.office365.com" />
    <add key="email_display_name" value="Paypln Automation" />
    <add key="email_userid" value="PayplnAutomation" />
    <add key="email_timeout_sec" value="120" />

  </appSettings>
</configuration>
